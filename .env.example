# --- set these in Vercel -> Project -> Settings -> Environment Variables ---
A2A_BEARER_TOKEN=replace-with-a-long-random-token
# EXACT URL you submit to the grader. Optional: defaults to https://<production-domain>/a2a/
BASE_URL=https://YOUR-PROJECT.vercel.app/a2a/
# Postgres (Neon / Supabase / Vercel Postgres). Use the POOLED connection string, sslmode=require.
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
AI_API_KEY=your-key
AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1
# Free Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
